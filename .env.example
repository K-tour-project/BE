# 이 파일은 "견본"이다. 복사해서 .env 를 만들고 실제 값을 채운다.
#   cp .env.example .env   (Windows: copy .env.example .env)
# .env 는 git에 올라가지 않는다(.gitignore).

APP_NAME=K-tour BE
ENVIRONMENT=local

# ── 2단계(DB) ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://ktour:ktour@localhost:5432/ktour

# ── 3단계(인증) ──────────────────────────────────────────────────────────────
# SECRET_KEY: 우리 서버가 JWT에 서명하는 키. 반드시 임의의 긴 문자열로 교체한다.
#   ⚠️ 이 값이 바뀌면 **발급된 access 토큰이 전부 무효**가 된다(사용자 재로그인).
#   생성: .venv/Scripts/python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=

# 토큰 수명 — 기본값(access 60분 / refresh 30일)이면 대개 건드릴 필요 없다.
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# REFRESH_TOKEN_EXPIRE_DAYS=30

# ── 3단계(소셜 로그인) ★배포 전 필수★ ────────────────────────────────────────
# 앱이 SDK로 받은 토큰을 우리 서버가 제공자에게 되물어 검증한다.
# 이 방식은 **client secret이 필요 없다.** 아래는 "이 토큰이 우리 앱 것인가"를 확인하는 값이다.
#
# ⚠️ 비워두면 그 검증을 건너뛴다 → **아무 앱의 구글/카카오 토큰으로도 우리 서버에 로그인된다.**
#    개발 중에만 비워두고, 배포 전엔 반드시 채운다. (비어 있으면 서버 로그에 경고가 찍힌다)
#
# GOOGLE_CLIENT_ID: 구글 클라우드 콘솔 > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID
#   안드로이드·iOS·웹을 따로 만들었다면 쉼표로 나열한다.
#   예: GOOGLE_CLIENT_ID=1234-abc.apps.googleusercontent.com,5678-def.apps.googleusercontent.com
# GOOGLE_CLIENT_ID=
#
# KAKAO_APP_ID: 카카오 개발자센터(developers.kakao.com) > 내 애플리케이션 > 앱 설정 > 요약 정보
#   의 **앱 ID(숫자)**다. REST API 키가 아니다.
# KAKAO_APP_ID=

# ── 3단계(이메일 인증 메일 발송) ─────────────────────────────────────────────
# ⚠️ SMTP_HOST가 비어 있으면 메일을 보내지 않고 **서버 로그에 인증코드를 출력**하고
#    /auth/email/send-code 응답의 `dev_code`에도 담아준다. 메일 계정 없이 개발·시연 가능.
#    아래를 채우면 코드 수정 없이 곧바로 실제 발송으로 바뀐다.
#
# 【Gmail 쓰는 법】
#   1. 구글 계정에 2단계 인증을 켠다 (myaccount.google.com > 보안)
#   2. myaccount.google.com/apppasswords 에서 '앱 비밀번호'를 만든다 → 16자리가 나온다
#   3. 그 16자리를 SMTP_PASSWORD에 넣는다 (계정 비밀번호가 아니다! 공백은 빼도 된다)
#   무료, 하루 약 500통. 앱 비밀번호는 언제든 폐기할 수 있다.
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=보내는주소@gmail.com
# SMTP_PASSWORD=앱비밀번호16자리
# SMTP_STARTTLS=true
# SMTP_FROM=            # 비우면 SMTP_USER를 발신자로 사용
# SMTP_FROM_NAME=Every Trip

# 인증코드 정책 (기본값이면 건드릴 필요 없다)
# EMAIL_CODE_EXPIRE_MINUTES=10          # 코드 유효시간
# EMAIL_CODE_MAX_ATTEMPTS=5             # 틀릴 수 있는 횟수
# EMAIL_CODE_RESEND_COOLDOWN_SECONDS=60 # 재발송 최소 간격
# EMAIL_VERIFIED_VALID_MINUTES=30       # 인증 후 가입까지 허용 시간

# ── 4단계(TourAPI) ★공모전 필수 요건★ ────────────────────────────────────────
# 【발급 방법】
#   1. https://www.data.go.kr 회원가입 (★팀장 1인 계정으로만 — 계정별 할당량이라 분산 금지)
#   2. 아래 두 서비스에 '활용신청'
#        · 한국관광공사_국문 관광정보 서비스_GW   https://www.data.go.kr/data/15101578/openapi.do
#        · 한국관광공사_관광사진 정보_GW          https://www.data.go.kr/data/15101914/openapi.do
#   3. 마이페이지 > 개발계정 > 인증키에서 **일반 인증키(Decoding)** 를 복사해 아래에 붙여넣기
#      (Encoding 키가 아니라 Decoding 키다. 헷갈리면 호출이 전부 실패한다.)
#
# 【주의】
#   · 개발계정 1,000건/일. 운영계정(10만건/일)은 서비스 완성 후 별도 신청.
#   · 이 키는 서버에서만 쓴다. 앱(APK)이나 git에 넣으면 노출되어 실격 사유. 유효기간 2년.
#   · 비워두면 TourAPI 기능만 막히고 나머지 서버 기능은 정상 동작한다.
#
# 【확인】 키를 넣은 뒤 아래를 실행하면 실제 호출로 검증한다.
#   .venv/Scripts/python.exe -m scripts.check_tour_api
# TOUR_API_KEY=
